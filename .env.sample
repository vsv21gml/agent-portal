# API (apps/api)
PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agent_portal
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
TYPEORM_SYNC=true
JWT_SECRET=dev-secret
JWT_EXPIRES_IN_SECONDS=43200
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# Dev auth bypass
AUTH_BYPASS=false
AUTH_BYPASS_USER_ID=dev-user-id
AUTH_BYPASS_EMAIL=dev@example.com
AUTH_BYPASS_ROLE=admin

# OIDC
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPE=openid profile email

# GitLab integration
GITLAB_BASE_URL=
GITLAB_TOKEN=

# LiteLLM integration
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=

# OpenSearch integration (VectorDB)
OPENSEARCH_URL=
OPENSEARCH_ADMIN_USERNAME=
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_INDEX_PREFIX=project

# K8s notebooks
K8S_NOTEBOOK_ENABLED=false
K8S_NOTEBOOK_NAMESPACE=agent-notebooks
KUBECONFIG_PATH=
NOTEBOOK_PVC=shared-notebooks-pvc
NOTEBOOK_IMAGE=jupyter/base-notebook:latest
NOTEBOOK_REQUEST_CPU=1
NOTEBOOK_REQUEST_MEM_GI=2
NOTEBOOK_DEFAULT_CPU=2
NOTEBOOK_DEFAULT_MEM=8Gi
ALB_OIDC_ISSUER=
ALB_OIDC_CLIENT_ID=
ALB_OIDC_CLIENT_SECRET=

# AWS EKS managed nodegroups for admin resource management
AWS_REGION=us-east-1
AWS_EKS_CLUSTER_NAME=
AWS_EKS_NODE_ROLE_ARN=
AWS_EKS_SUBNET_IDS=
AWS_EKS_WORKSPACE_NODE_INSTANCE_TYPES=t3.large
AWS_EKS_WORKSPACE_NODE_MIN_SIZE=1
AWS_EKS_WORKSPACE_NODE_MAX_SIZE=3
AWS_EKS_WORKSPACE_NODE_DESIRED_SIZE=1
AWS_EKS_WORKSPACE_NODE_DISK_SIZE=50
AWS_EKS_WORKSPACE_NODE_CAPACITY_TYPE=ON_DEMAND
AWS_EKS_WORKSPACE_NODE_AMI_TYPE=
AWS_EKS_SERVING_NODE_INSTANCE_TYPES=t3.large
AWS_EKS_SERVING_NODE_MIN_SIZE=1
AWS_EKS_SERVING_NODE_MAX_SIZE=3
AWS_EKS_SERVING_NODE_DESIRED_SIZE=1
AWS_EKS_SERVING_NODE_DISK_SIZE=50
AWS_EKS_SERVING_NODE_CAPACITY_TYPE=ON_DEMAND
AWS_EKS_SERVING_NODE_AMI_TYPE=

# Web (apps/web)
NEXT_PUBLIC_ADMIN_WEB_URL=http://localhost:3100
BACKEND_URL=http://localhost:4000

# Admin Web (apps/admin-web)
BACKEND_URL=http://localhost:4000
